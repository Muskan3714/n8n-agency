        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"openai/gpt-oss-120b\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"You are an intake assistant for a Sydney trades business. Extract structured details from incoming customer messages.\"},\n    {\"role\": \"user\", \"content\": \"hi its dave from marrickville, my hot water systems been making this weird banging noise for like 2 days now, kinda worried its gonna blow, could someone maybe come out tmrw arvo if poss? cheers\"}\n  ],\n  \"response_format\": {\n    \"type\": \"json_schema\",\n    \"json_schema\": {\n      \"name\": \"job_extraction\",\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\"type\": [\"string\", \"null\"]},\n          \"suburb\": {\"type\": [\"string\", \"null\"]},\n          \"job_type\": {\"type\": [\"string\", \"null\"]},\n          \"urgency\": {\"type\": \"string\", \"enum\": [\"low\", \"medium\", \"high\"]},\n          \"preferred_time\": {\"type\": [\"string\", \"null\"]}\n        },\n        \"required\": [\"name\", \"suburb\", \"job_type\", \"urgency\", \"preferred_time\"],\n        \"additionalProperties\": false\n      }\n    }\n  }\n}",
        "options": {}
      },

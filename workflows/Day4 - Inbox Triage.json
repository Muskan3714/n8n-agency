    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.choices[0].message.content;\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  return [{ json: { valid: false, error: \"not valid JSON\", raw } }];\n}\n\nconst requiredKeys = [\"name\", \"suburb\", \"job_type\", \"urgency\", \"preferred_time\"];\nconst missingKeys = requiredKeys.filter(k => !(k in parsed));\nif (missingKeys.length > 0) {\n  return [{ json: { valid: false, error: `missing keys: ${missingKeys.join(\", \")}`, raw: parsed } }];\n}\n\nconst validUrgency = [\"low\", \"medium\", \"high\"];\nif (!validUrgency.includes(parsed.urgency)) {\n  return [{ json: { valid: false, error: \"invalid urgency value\", raw: parsed } }];\n}\n\nreturn [{ json: { valid: true, ...parsed } }];"
      },
      "type": "n8n-nodes-base.code",

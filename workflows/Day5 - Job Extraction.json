        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"You are an intake assistant for a Sydney trades business. Extract structured details from incoming customer messages. Respond with a JSON object with exactly these keys: name, suburb, job_type, urgency, preferred_time. urgency must be exactly one of: low, medium, high. Use null for any field not mentioned in the message.\"},\n    {\"role\": \"user\", \"content\": \"={{ $json.body.message }}\"}\n  ],\n  \"response_format\": {\"type\": \"json_object\"}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
